#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
checker="$repo_root/scripts/check-release-clean.sh"
remote_name="${1:?missing remote name}"
zero="0000000000000000000000000000000000000000"
commits=()

add_commit() {
	local candidate="$1"
	local existing
	for existing in "${commits[@]}"; do
		[[ "$existing" == "$candidate" ]] && return
	done
	commits+=("$candidate")
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
	[[ "$local_sha" == "$zero" ]] && continue

	if [[ "$remote_sha" == "$zero" ]]; then
		commit_list="$(git rev-list --reverse "$local_sha" --not "--remotes=$remote_name")"
	else
		commit_list="$(git rev-list --reverse "$remote_sha..$local_sha")"
	fi
	while read -r commit; do
		[[ -n "$commit" ]] && add_commit "$commit"
	done <<< "$commit_list"
done

for commit in "${commits[@]}"; do
	"$checker" --ref "$commit"
done
